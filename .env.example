# apps/api が読む接続先（docker compose の db に合わせた値）
DATABASE_URL=postgresql://trends:trends@localhost:5432/trends?schema=public
# apps/web が呼ぶ API のURL
VITE_API_URL=http://localhost:3001

# ログイン（apps/api）
# Google ログインの OAuth クライアント ID（Google Cloud コンソール → API とサービス → 認証情報）
GOOGLE_CLIENT_ID=
# ログインのトークンに署名する鍵。空なら初回起動時に作って DB に保存する
SESSION_SECRET=
# true にすると、Google を使わず名前だけでログインできる（手元の開発・テスト用。本番では false）
AUTH_DEV_LOGIN=true
# App Store Connect のアプリの Apple ID（数字）。買い切りの本番の購入を確かめるのに要る。空なら Sandbox の購入だけ確かめる
APPLE_APP_ID=
