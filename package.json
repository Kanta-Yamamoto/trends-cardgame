{
  "name": "trends-cardgame",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "db:up": "docker compose up -d db",
    "db:migrate": "pnpm --filter @trends/api db:migrate",
    "db:seed": "pnpm --filter @trends/api db:seed",
    "db:generate": "pnpm --filter @trends/api db:generate"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "turbo": "^2.11.8",
    "typescript": "^5.9.3"
  }
}
