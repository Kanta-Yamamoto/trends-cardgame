{
  "name": "trends-cardgame",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "verify": "pnpm lint && pnpm turbo run build --filter=./packages/* && pnpm db:migrate && pnpm typecheck && pnpm test && pnpm build && sh scripts/mark-verified.sh",
    "verify:image": "docker build -f apps/api/Dockerfile -t trends-api .",
    "db:up": "docker compose up -d db",
    "db:migrate": "pnpm --filter @trends/api db:migrate",
    "db:seed": "pnpm --filter @trends/api db:seed",
    "db:generate": "pnpm --filter @trends/api db:generate",
    "logs:cpu": "node tools/cpu-logs.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "turbo": "^2.11.8",
    "typescript": "^5.9.3"
  }
}
