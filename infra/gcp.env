# GCP の設定（秘密の値ではない）。GitHub Actions の Infra / Deploy がここを読む。
# GCP_PROJECT_NUMBER が空のあいだは、Infra も Deploy も何もしない。
GCP_PROJECT_ID=trends-cardgame
GCP_PROJECT_NUMBER=523738975867
GCP_REGION=asia-northeast1
# Google ログインの OAuth クライアント ID（公開してよい値）
GOOGLE_CLIENT_ID=523738975867-ff9kuaia3up328025q057knskb3ea6vs.apps.googleusercontent.com
# App Store Connect のアプリの Apple ID（公開してよい値）。買い切りの本番の購入を確かめるのに使う
APPLE_APP_ID=6829398027
